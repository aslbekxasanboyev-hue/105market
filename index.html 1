/* --- Firebase (Firestore + Auth) --- */
const FBI={
  P:null,S:null,O:null,_pp:null,_op:null,_unO:[],
  _col(n){return FB.F.collection(FB.db,n)},
  _ref(c,id){return FB.F.doc(FB.db,c,String(id))},
  err(e,adm){
    if(e&&(e.message==="stock"||e.message==="invalid"))return e;
    const c=(e&&e.code)||"",x=new Error(c==="unavailable"?"net":"server");x.code=c;
    if(adm&&(c==="permission-denied"||c==="unauthenticated"))x.status=401;
    return x;
  },
  _listen(ref,set,isDoc,bucket){
    return new Promise((res,rej)=>{let first=true;
      const un=FB.F.onSnapshot(ref,sn=>{set(isDoc?(sn.exists()?sn.data():null):sn.docs.map(d=>d.data()));if(first){first=false;res()}},
        e=>{if(first){first=false;rej(e)}});
      if(bucket)bucket.push(un)});
  },
  startPublic(){
    if(!this._pp)this._pp=Promise.all([
      this._listen(this._col("products"),v=>{this.P=v.sort((a,b)=>a.id-b.id)}),
      this._listen(this._ref("settings","public"),v=>{this.S=v},true)
    ]).catch(e=>{this._pp=null;throw e});
    return this._pp;
  },
  startOrders(){
    if(!this._op)this._op=this._listen(this._col("orders"),v=>{this.O=v.sort((a,b)=>a.id-b.id)},false,this._unO).catch(e=>{this._op=null;throw e});
    return this._op;
  },
  authReady(){return new Promise(res=>{const un=FB.U.onAuthStateChanged(FB.auth,()=>{un();res()})})},
  async login(email,pw){
    try{await FB.U.signInWithEmailAndPassword(FB.auth,String(email||"").trim(),pw)}
    catch(e){const c=e.code||"",x=new Error(c==="auth/network-request-failed"?"net":"wrong");x.status=c==="auth/too-many-requests"?429:(x.message==="wrong"?401:undefined);throw x}
    try{await FB.F.getDocs(FB.F.query(this._col("orders"),FB.F.limit(1)));await this.ensureSeed()}
    catch(e){await FB.U.signOut(FB.auth);const pd=e.code==="permission-denied",x=new Error(pd?"wrong":"server");if(pd)x.status=401;throw x}
  },
  async ensureSeed(){
    const F=FB.F,sn=await F.getDoc(this._ref("settings","public"));
    if(sn.exists())return;
    const b=F.writeBatch(FB.db);
    b.set(this._ref("settings","public"),pubSettings(SEED.settings));
    b.set(this._ref("meta","counter"),{n:1000});
    SEED.products.forEach(p=>b.set(this._ref("products",p.id),p));
    await b.commit();
  },
  async logout(){
    this._unO.forEach(f=>{try{f()}catch(e){}});this._unO=[];this._op=null;this.O=null;
    try{await FB.U.signOut(FB.auth)}catch(e){}
  },
  async getPublic(){
    try{await this.startPublic()}catch(e){throw this.err(e)}
    return JSON.parse(JSON.stringify({settings:pubSettings(this.S||SEED.settings),products:this.P.filter(p=>p.active!==false)}));
  },
  async getAdmin(){
    try{await this.startPublic();await this.startOrders()}catch(e){throw this.err(e,1)}
    return JSON.parse(JSON.stringify({products:this.P,orders:this.O,settings:this.S||pubSettings(SEED.settings)}));
  },
  async order(b,status,adm){
    const F=FB.F;
    try{
      const ids=[...new Set((b.items||[]).map(i=>+i.id).filter(Number.isFinite))];
      const id=await F.runTransaction(FB.db,async tx=>{
        const cRef=this._ref("meta","counter");
        const cs=await tx.get(cRef),ss=await tx.get(this._ref("settings","public"));
        const ps=await Promise.all(ids.map(i=>tx.get(this._ref("products",i))));
        const n=cs.exists()?cs.data().n:1000;
        const st={products:ps.filter(x=>x.exists()).map(x=>x.data()),settings:ss.exists()?ss.data():SEED.settings,orders:[{id:n}]};
        const before=new Map(st.products.map(p=>[p.id,p.stock]));
        const o=computeOrder(st,b,adm?status:undefined);
        if(cs.exists())tx.update(cRef,{n:o.id});else tx.set(cRef,{n:o.id});
        tx.set(this._ref("orders",o.id),o);
        st.products.forEach(p=>{if(p.stock!==before.get(p.id))tx.update(this._ref("products",p.id),{stock:p.stock})});
        return o.id;
      });
      return{id};
    }catch(e){throw this.err(e,adm)}
  },
  async setStatus(id,s){
    const F=FB.F;
    try{
      await F.runTransaction(FB.db,async tx=>{
        const oRef=this._ref("orders",id),os=await tx.get(oRef);
        if(!os.exists())throw new Error("invalid");
        const o=os.data(),ids=[...new Set(o.items.map(i=>i.id))];
        const ps=await Promise.all(ids.map(i=>tx.get(this._ref("products",i))));
        const st={products:ps.filter(x=>x.exists()).map(x=>x.data()),orders:[o]};
        const before=new Map(st.products.map(p=>[p.id,p.stock]));
        applyStatus(st,o.id,s);
        tx.update(oRef,{status:s});
        st.products.forEach(p=>{if(p.stock!==before.get(p.id))tx.update(this._ref("products",p.id),{stock:p.stock})});
      });
      return{ok:1};
    }catch(e){throw this.err(e,1)}
  },
  async deleteOrder(id){try{await FB.F.deleteDoc(this._ref("orders",id));return{ok:1}}catch(e){throw this.err(e,1)}},
  async saveProduct(p){
    try{
      p={...p};
      if(!p.id)p.id=(this.P||[]).reduce((m,x)=>Math.max(m,x.id),0)+1;
      p.id=+p.id;
      await FB.F.setDoc(this._ref("products",p.id),p);
      return{product:p};
