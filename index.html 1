  ok.forEach(o=>{days.find(x=>x.k===dkey(o.date)).v+=o.total});
  const rev=sum(ok),today=sum(D.orders.filter(o=>o.status!=="cancelled"&&dkey(o.date)===dkey(Date.now())));
  const newN=D.orders.filter(o=>o.status==="new").length,low=D.products.filter(p=>p.stock<=5).length;
  const mx=Math.max(1,...days.map(d=>d.v)),W=700,H=200,n=days.length,slot=W/n,bw=slot*.68;
  const svg=`<svg viewBox="0 0 ${W} ${H+34}" width="100%">${days.map((d,i)=>{const h=d.v/mx*(H-26),x=i*slot+(slot-bw)/2;
    return `<rect x="${x}" y="${H-h}" width="${bw}" height="${Math.max(h,1)}" rx="4" fill="#1565d8"/>`+
    (n<=7&&d.v?`<text x="${x+bw/2}" y="${H-h-6}" font-size="12" text-anchor="middle" fill="#13233f">${Math.round(d.v/1000)}k</text>`:"")+
