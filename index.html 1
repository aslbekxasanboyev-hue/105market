}
async function saveSettings(){
  const r=await act(()=>DB.saveSettings({name:$("#s_name").value.trim()||"105 Market",phone:$("#s_phone").value.trim(),addr:$("#s_addr").value.trim(),hours:$("#s_hours").value.trim(),deliveryFee:Math.max(0,+$("#s_fee").value||0),freeFrom:Math.max(0,+$("#s_free").value||0)}));
  if(r){toast(t("saved"));await refresh(true)}
}
async function savePass(){
  const v=$("#s_pass").value;if(v.length<6)return toast(t("a_pass_short"));
  const r=await act(()=>DB.setPassword(v));if(r){$("#s_pass").value="";toast(t("saved"))}
}


/* ===== общий код: шапка, переключение страниц ===== */
let isAdmin=false;
function renderHeader(){
  const nm=(isAdmin?(D.settings&&D.settings.name):S.name)||S.name||"105 Market",[a,...b]=nm.split(" ");
  $("#logo").innerHTML=(b.length?`<b>${esc(a)}</b>${esc(b.join(" "))}`:`<b>${esc(a)}</b>`)+(isAdmin?`<small>${t("a_title")}</small>`:"");
  document.title=isAdmin?nm+" — "+t("a_title"):nm;
  $("#outBtn").classList.toggle("hidden",!DB.isAuthed());
  const dm=$("#demo");dm.textContent=t("demo");dm.classList.toggle("hidden",DB.mode!=="local");
}
function logoClick(){if(isAdmin)location.hash="";else window.scrollTo(0,0)}
function chLang(l){setLang(l);closeModal();applyI18n();if(isAdmin)renderApp();else renderStore()}
async function route(){
  isAdmin=location.hash==="#admin";
  document.body.classList.toggle("adm",isAdmin);
  closeModal();closeCart();
  if(isAdmin){renderApp()}
  else{try{await loadData()}catch(e){toast(t("err_net"))}renderStore()}
  window.scrollTo(0,0);
}
(async function(){
  await DB.init();
  try{await loadData()}catch(e){toast(t("err_net"))}
  await route();
  window.addEventListener("hashchange",route);
  setInterval(async()=>{
    if(isAdmin){if(DB.isAuthed()&&!document.hidden)refresh(false);return}
    if($("#drawer").classList.contains("show"))return;
    try{await loadData();renderCats();renderGrid();renderCart()}catch(e){}
  },isAdmin?8000:8000);
  window.addEventListener("storage",async()=>{if(isAdmin)return;try{await loadData();renderStore()}catch(e){}});
})();
</script>
