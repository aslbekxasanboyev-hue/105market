   <label>${t("a_s_name")}</label><input id="s_name" value="${esc(s.name)}">
   <label>${t("a_s_phone")}</label><input id="s_phone" value="${esc(s.phone)}">
   <label>${t("a_s_addr")}</label><input id="s_addr" value="${esc(s.addr)}">
   <label>${t("a_s_hours")}</label><input id="s_hours" value="${esc(s.hours||"")}">
   <div class="two"><div><label>${t("a_s_fee")}</label><input id="s_fee" type="number" min="0" value="${s.deliveryFee||0}"></div><div><label>${t("a_s_free")}</label><input id="s_free" type="number" min="0" value="${s.freeFrom||0}"></div></div></div>
   <button class="btn" onclick="saveSettings()">${t("save")}</button></div>
