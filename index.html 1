const pubSettings=s=>({name:s.name,phone:s.phone,addr:s.addr,hours:s.hours,deliveryFee:s.deliveryFee,freeFrom:s.freeFrom});

/* --- расчёт заказа (то же самое делает server.js) --- */
function computeOrder(st,body,status){
  const c=body.customer||{};
  const name=String(c.name||"").trim().slice(0,80),phone=String(c.phone||"").trim().slice(0,30),addr=String(c.addr||"").trim().slice(0,200),comment=String(c.comment||"").trim().slice(0,300);
  const delivery=body.delivery==="pickup"?"pickup":"delivery",payment=body.payment==="card"?"card":"cash";
  if(name.length<2||phone.replace(/\D/g,"").length<9||(delivery==="delivery"&&addr.length<3))throw new Error("invalid");
  const items=[];let sub=0;
  for(const it of body.items||[]){
    const p=st.products.find(x=>x.id===+it.id&&x.active!==false),q=Math.floor(+it.qty);
    if(!p||!(q>=1&&q<=99))throw new Error("invalid");
    if(q>p.stock)throw new Error("stock");
    items.push({id:p.id,name:p.name,price:p.price,qty:q});sub+=p.price*q;
  }
  if(!items.length)throw new Error("invalid");
  const s=st.settings,fee=delivery==="delivery"&&!(s.freeFrom>0&&sub>=s.freeFrom)?(+s.deliveryFee||0):0;
  items.forEach(i=>{st.products.find(p=>p.id===i.id).stock-=i.qty});
  const id=st.orders.reduce((m,o)=>Math.max(m,o.id),1000)+1;
  const o={id,date:new Date().toISOString(),customer:{name,phone,addr,comment},items,sub,fee,total:sub+fee,delivery,payment,status:STATUSES.includes(status)?status:"new"};
  st.orders.push(o);return o;
}
function applyStatus(st,id,s){
  const o=st.orders.find(x=>x.id===id);if(!o||!STATUSES.includes(s))throw new Error("invalid");
  if(s==="cancelled"&&o.status!=="cancelled")o.items.forEach(i=>{const p=st.products.find(x=>x.id===i.id);if(p)p.stock+=i.qty});
  if(o.status==="cancelled"&&s!=="cancelled")o.items.forEach(i=>{const p=st.products.find(x=>x.id===i.id);if(p)p.stock=Math.max(0,p.stock-i.qty)});
  o.status=s;
}

