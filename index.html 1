<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>105 Market</title>
<style>
:root{--blue:#1565d8;--blue-d:#0d47a1;--blue-l:#eaf2ff;--line:#dbe6f7;--text:#13233f;--muted:#6b7a99;--red:#e53935;--green:#2e9e5b;--orange:#f59e0b}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--blue-l);color:var(--text);line-height:1.4;-webkit-text-size-adjust:100%}
button{font-family:inherit;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:16px;color:var(--text)}
.hidden{display:none!important}
header{background:var(--blue);color:#fff;position:sticky;top:0;z-index:10;box-shadow:0 2px 10px rgba(13,71,161,.3)}
.bar{max-width:1150px;margin:0 auto;padding:12px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.logo{font-size:22px;font-weight:800;white-space:nowrap;cursor:pointer}
.logo b{background:#fff;color:var(--blue);padding:2px 8px;border-radius:8px;margin-right:6px}
.logo small{font-size:13px;font-weight:600;opacity:.85;margin-left:8px}
.sp{flex:1}
.hbtn{background:#fff;color:var(--blue);border:0;border-radius:10px;padding:10px 14px;font-weight:700;font-size:15px;text-decoration:none;display:inline-block}
.hbtn.ghost{background:rgba(255,255,255,.18);color:#fff}
.lang{display:flex;background:rgba(255,255,255,.18);border-radius:10px;padding:3px}
.lang button{background:none;border:0;color:#fff;font-weight:700;padding:7px 11px;border-radius:8px;font-size:14px}
.lang button.on{background:#fff;color:var(--blue)}
.badge{background:var(--red);color:#fff;border-radius:99px;font-size:12px;padding:1px 7px;margin-left:6px}
.btn{background:var(--blue);color:#fff;border:0;border-radius:10px;padding:10px 16px;font-weight:700;font-size:15px}
.btn:hover{background:var(--blue-d)}.btn:disabled{background:#b6c4de;cursor:not-allowed}
.btn.sec{background:var(--blue-l);color:var(--blue)}.btn.danger{background:#fdeaea;color:var(--red)}.btn.ok{background:var(--green)}
.btn.sm{padding:7px 11px;font-size:13px;border-radius:8px}
.field label{font-size:13px;color:var(--muted);font-weight:600;display:block;margin-bottom:3px}
.field input,.field select,.field textarea,.inp{width:100%;padding:10px;border:1px solid #c7d6f0;border-radius:10px;margin-bottom:10px;background:#fff}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.note{font-size:12px;color:var(--muted)}
.overlay{position:fixed;inset:0;background:rgba(10,25,60,.5);display:none;z-index:20}.overlay.show{display:block}
.modal{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:12px;background:rgba(10,25,60,.55)}
.modal.show{display:flex}
.mbox{background:#fff;border-radius:16px;max-width:620px;width:100%;max-height:92vh;overflow-y:auto;padding:20px;position:relative}
.mbox h2{margin-bottom:12px;font-size:20px;padding-right:30px}
.mclose{position:absolute;top:10px;right:14px;background:none;border:0;font-size:28px;color:var(--muted)}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--blue-d);color:#fff;padding:12px 20px;border-radius:10px;display:none;z-index:99;max-width:92%;text-align:center}
.st{padding:3px 10px;border-radius:99px;font-size:12px;font-weight:700;white-space:nowrap}
.st.new{background:#e0edff;color:var(--blue)}.st.processing{background:#fff3d6;color:#b77900}.st.ready{background:#e6e0ff;color:#5b3fd0}.st.delivered{background:#dff5e8;color:var(--green)}.st.cancelled{background:#fdeaea;color:var(--red)}
.demo{background:#fff3d6;color:#7a5200;text-align:center;font-size:13px;padding:8px 12px}
.photo-prev{width:100%;height:150px;background:var(--blue-l);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:50px;overflow:hidden;margin-bottom:8px}
.photo-prev img{width:100%;height:100%;object-fit:cover}

main{max-width:1150px;margin:0 auto;padding:16px}
.search{flex:1;min-width:160px;display:flex;background:#fff;border-radius:10px;overflow:hidden}
.search input{flex:1;border:0;padding:11px 14px;outline:none;min-width:0}
.search span{padding:0 12px;display:flex;align-items:center}
.hero{background:linear-gradient(135deg,var(--blue),var(--blue-d));color:#fff;border-radius:18px;padding:26px;margin-bottom:16px;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}
.hero h1{font-size:26px;margin-bottom:6px}.hero p{opacity:.9}
.perks{display:flex;gap:10px;flex-wrap:wrap}.perk{background:rgba(255,255,255,.16);padding:8px 14px;border-radius:10px;font-size:14px}
.tools{display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap}
.cats{display:flex;gap:8px;overflow-x:auto;flex:1;padding-bottom:4px}
.cat{background:#fff;color:var(--blue);border:2px solid var(--blue);border-radius:99px;padding:7px 16px;font-weight:600;white-space:nowrap}
.cat.on{background:var(--blue);color:#fff}
.tools select{padding:9px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:15px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:14px}
.card{background:#fff;border-radius:14px;padding:12px;display:flex;flex-direction:column;box-shadow:0 2px 8px rgba(21,101,216,.1);position:relative;transition:.15s}
.card:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(21,101,216,.18)}
.pic{height:140px;background:var(--blue-l);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:56px;overflow:hidden;margin-bottom:10px;cursor:pointer}
.pic img{width:100%;height:100%;object-fit:cover}
.tag{position:absolute;top:18px;left:18px;background:var(--red);color:#fff;font-size:12px;font-weight:700;padding:2px 8px;border-radius:6px}
.pcat{font-size:12px;color:var(--muted);margin-bottom:2px}
.pname{font-weight:600;font-size:15px;flex:1;cursor:pointer}
.prow{margin:6px 0 10px;display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.price{color:var(--blue);font-weight:800}.old{color:var(--muted);text-decoration:line-through;font-size:13px}
.empty{text-align:center;color:var(--muted);padding:40px 0;grid-column:1/-1}
footer{text-align:center;color:var(--muted);padding:26px 16px;font-size:14px;line-height:1.7}
.drawer{position:fixed;top:0;right:-100%;width:min(430px,100%);height:100%;background:#fff;z-index:30;transition:right .25s;display:flex;flex-direction:column}
.drawer.show{right:0}
.dh{background:var(--blue);color:#fff;padding:16px;display:flex;justify-content:space-between;font-weight:700;font-size:18px}
.dh button{background:none;border:0;color:#fff;font-size:28px;line-height:1}
.items{flex:1;overflow-y:auto;padding:12px;min-height:90px}
.item{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.item .th{width:48px;height:48px;border-radius:8px;background:var(--blue-l);display:flex;align-items:center;justify-content:center;font-size:26px;overflow:hidden;flex-shrink:0}
.item .th img{width:100%;height:100%;object-fit:cover}
.item .i{flex:1;font-size:14px}
.qty{display:flex;align-items:center;gap:8px}
.qty button{width:30px;height:30px;border-radius:8px;border:0;background:var(--blue-l);color:var(--blue);font-weight:800;font-size:16px}
.foot{padding:14px;border-top:1px solid var(--line);max-height:62%;overflow-y:auto}
.foot h4{font-size:13px;color:var(--muted);margin:4px 0 6px}
.seg{display:flex;gap:6px;margin-bottom:10px}
.seg button{flex:1;background:#fff;border:2px solid var(--line);border-radius:10px;padding:9px 6px;font-weight:600;color:var(--text);font-size:14px}
.seg button.on{border-color:var(--blue);background:var(--blue-l);color:var(--blue)}
.sumrow{display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px}
.sumrow.t{font-weight:800;font-size:18px;margin:6px 0 10px}
.foot .btn{width:100%;padding:13px;font-size:16px}

.panel{max-width:1150px;margin:0 auto;padding:16px}
.tabs{display:flex;gap:8px;margin-bottom:16px;overflow-x:auto;padding-bottom:2px}
.tab{background:#fff;border:2px solid var(--blue);color:var(--blue);border-radius:10px;padding:9px 16px;font-weight:700;white-space:nowrap;font-size:15px}
.tab.on{background:var(--blue);color:#fff}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:16px}
.stat{background:#fff;border-radius:14px;padding:14px 16px;border-left:5px solid var(--blue)}
.stat small{color:var(--muted);font-weight:600}.stat div{font-size:21px;font-weight:800;margin-top:4px}
.box{background:#fff;border-radius:14px;padding:16px;margin-bottom:16px}
.box h3{margin-bottom:12px;font-size:17px}
.two-col{display:grid;grid-template-columns:2fr 1fr;gap:16px}
@media(max-width:800px){.two-col{grid-template-columns:1fr}}
.login{max-width:360px;margin:50px auto;background:#fff;border-radius:16px;padding:26px;text-align:center}
.login h2{margin:6px 0}.login p{color:var(--muted);margin-bottom:14px;font-size:14px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.chip{background:#fff;border:2px solid var(--line);border-radius:99px;padding:6px 14px;font-weight:600;font-size:14px;color:var(--text)}
.chip.on{border-color:var(--blue);background:var(--blue-l);color:var(--blue)}
.toolbar{display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.toolbar .inp{flex:1;min-width:180px;margin:0}
.ord{border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px;display:grid;grid-template-columns:1fr auto;gap:6px 12px;align-items:center}
.ord .h{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ord .tot{font-weight:800;color:var(--blue);text-align:right}
.ord .act{grid-column:1/-1;display:flex;gap:6px;flex-wrap:wrap}
.ord.fresh{border-color:var(--blue);background:#f5f9ff}
.bar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:14px}
.bar-row .b{height:10px;background:var(--blue);border-radius:6px}
.prod{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:10px 0;border-bottom:1px solid var(--line)}
.prod .th{width:50px;height:50px;border-radius:10px;background:var(--blue-l);display:flex;align-items:center;justify-content:center;font-size:26px;overflow:hidden;flex-shrink:0}
.prod .th img{width:100%;height:100%;object-fit:cover}
.prod .info{flex:1;min-width:140px}
.prod label{font-size:11px;color:var(--muted);font-weight:600;display:block}
.prod input.pi{width:105px;padding:7px;border:1px solid #c7d6f0;border-radius:8px;font-size:15px}
.prod input.pi.s{width:70px}
.prod .sw{display:flex;align-items:center;gap:5px;font-size:13px}
.prod .sw input{width:18px;height:18px}
table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;color:var(--muted);font-size:12px;text-transform:uppercase;padding:8px;border-bottom:2px solid var(--line)}
td{padding:9px 8px;border-bottom:1px solid var(--line)}
.tw{overflow-x:auto}
.line{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px dashed var(--line);font-size:14px}
#adminView .empty{text-align:center;color:var(--muted);padding:30px 0}
a.tel{color:var(--blue);font-weight:600;text-decoration:none}

/* --- переключение страниц магазин / кабинет --- */
body.adm [data-v="store"]{display:none!important}
body:not(.adm) [data-v="admin"]{display:none!important}
footer a{color:var(--muted);font-size:12px}
</style>
</head>
