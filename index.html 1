    <button class="hbtn ghost hidden" id="outBtn" data-v="admin" data-i="a_logout" onclick="logout()"></button>
  </div>
</header>

<!-- ===== МАГАЗИН ===== -->
<div id="storeView" data-v="store">
<main>
  <div class="hero">
