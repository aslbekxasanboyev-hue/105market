  </div>
  <div class="grid" id="grid"></div>
</main>
<footer id="footer"></footer>

<div class="overlay" id="ov" onclick="closeCart()"></div>
<div class="drawer" id="drawer">
  <div class="dh"><span data-i="s_yourcart"></span><button onclick="closeCart()">×</button></div>
  <div class="items" id="items"></div>
  <div class="foot">
    <div class="field">
      <input id="cn" data-ip="s_name" autocomplete="name">
      <input id="cp" data-ip="s_phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+998">
    </div>
    <h4 data-i="s_delivery"></h4>
    <div class="seg"><button id="dl_delivery" data-i="dl_delivery" onclick="setDl('delivery')"></button><button id="dl_pickup" data-i="dl_pickup" onclick="setDl('pickup')"></button></div>
    <div class="field"><input id="ca" data-ip="s_addr" autocomplete="street-address"></div>
    <div class="note" id="pickNote" style="margin-bottom:10px"></div>
    <h4 data-i="s_payment"></h4>
    <div class="seg"><button id="pay_cash" data-i="pay_cash" onclick="setPay('cash')"></button><button id="pay_card" data-i="pay_card" onclick="setPay('card')"></button></div>
    <div class="field"><input id="cc" data-ip="s_comment"></div>
    <div class="sumrow"><span data-i="s_sub"></span><span id="sSub"></span></div>
    <div class="sumrow"><span data-i="s_fee"></span><span id="sFee"></span></div>
    <div class="sumrow t"><span data-i="s_total"></span><span id="sTotal"></span></div>
    <button class="btn" id="orderBtn" data-i="s_order" onclick="placeOrder()"></button>
  </div>
</div>

</div>

<!-- ===== КАБИНЕТ ===== -->
