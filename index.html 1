  const fee=dl==="delivery"&&sub>0&&!(S.freeFrom>0&&sub>=S.freeFrom)?(+S.deliveryFee||0):0;return{sub,fee,total:sub+fee}}
function renderCart(){
  for(const id in cart){const p=byId(id);if(!p||p.stock<=0)delete cart[id];else if(cart[id]>p.stock)cart[id]=p.stock}
  saveCart();
  const ids=Object.keys(cart);
