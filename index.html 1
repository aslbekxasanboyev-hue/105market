    <div class="stat" style="border-color:var(--red)"><small>${t("a_new")}</small><div>${newN}</div></div>
    <div class="stat" style="border-color:var(--orange)"><small>${t("a_low")}</small><div>${low}</div></div></div>
   <div class="two-col"><div class="box"><h3>${t("a_chart")}</h3>${svg}</div>
    <div class="box"><h3>${t("a_top")}</h3>${top.length?top.map(x=>`<div class="bar-row"><div style="width:100px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(x.n)}</div><div class="b" style="width:${x.q/tm*100}%;min-width:6px"></div><b>${x.q}</b></div>`).join(""):`<p class="note">${t("a_nosales")}</p>`}</div></div>
