function showOrder(id){
  const o=D.orders.find(x=>x.id===id);if(!o)return;
  openModal(`<h2>${t("a_order")} №${o.id}</h2>${stBadge(o.status)} <span class="note">${fdate(o.date)}</span>
   <div style="margin:12px 0"><b>${esc(o.customer.name)}</b><br><a class="tel" href="tel:${esc(o.customer.phone)}">${esc(o.customer.phone)}</a>
   ${o.customer.addr?`<br>📍 ${esc(o.customer.addr)}`:""}<br><span class="note">${t("dl_"+o.delivery)} · ${t("pay_"+o.payment)}</span>
   ${o.customer.comment?`<br>💬 <i>${esc(o.customer.comment)}</i>`:""}</div>
   <h3 style="font-size:15px;margin-bottom:6px">${t("a_items")}</h3>
   ${o.items.map(i=>`<div class="line"><span>${esc(L(i.name))} × ${i.qty}</span><b>${fmt(i.price*i.qty)}</b></div>`).join("")}
   <div class="line"><span>${t("s_fee")}</span><span>${o.fee?fmt(o.fee):t("s_free")}</span></div>
   <div class="line" style="font-size:18px;font-weight:800;border:0"><span>${t("a_total")}</span><span>${fmt(o.total)}</span></div>
   <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:12px">${nextBtn(o)}<button class="btn sec" onclick="printOrder(${o.id})">🖨 ${t("a_print")}</button>
   ${o.status!=="cancelled"&&o.status!=="delivered"?`<button class="btn danger" onclick="setStatus(${o.id},'cancelled')">${t("a_cancel_order")}</button>`:""}
   ${o.status==="cancelled"?`<button class="btn sec" onclick="setStatus(${o.id},'new')">↩ ${t("st_new")}</button>`:""}
   <button class="btn danger" onclick="delOrder(${o.id})">${t("a_delete_order")}</button></div>`);
  $("#mbox").dataset.order=id;
}
async function delOrder(id){if(!confirm(t("confirm_del")))return;const r=await act(()=>DB.deleteOrder(id));if(r){closeModal();await refresh(true)}}
function printOrder(id){
  const o=D.orders.find(x=>x.id===id);if(!o)return;
  const html=`<html><head><meta charset="utf-8"><title>№${o.id}</title><style>body{font-family:sans-serif;max-width:380px;margin:10px auto;font-size:14px}h2{text-align:center}table{width:100%;border-collapse:collapse}td{padding:4px 0;border-bottom:1px dashed #999}td:last-child{text-align:right}.t{font-size:18px;font-weight:bold}</style></head><body>
   <h2>${esc(D.settings.name||"")}</h2><p style="text-align:center">${esc(D.settings.phone||"")}</p><hr>
   <p><b>${t("a_order")} №${o.id}</b><br>${fdate(o.date)}</p>
   <p>${esc(o.customer.name)}<br>${esc(o.customer.phone)}<br>${esc(o.customer.addr||"")}<br>${t("dl_"+o.delivery)} · ${t("pay_"+o.payment)}</p>
   <table>${o.items.map(i=>`<tr><td>${esc(L(i.name))} × ${i.qty}</td><td>${fmt(i.price*i.qty)}</td></tr>`).join("")}
   <tr><td>${t("s_fee")}</td><td>${o.fee?fmt(o.fee):t("s_free")}</td></tr><tr class="t"><td>${t("a_total")}</td><td>${fmt(o.total)}</td></tr></table>
   ${o.customer.comment?`<p>💬 ${esc(o.customer.comment)}</p>`:""}</body></html>`;
  const f=document.createElement("iframe");f.style.cssText="position:fixed;width:0;height:0;border:0";document.body.appendChild(f);
  f.contentDocument.open();f.contentDocument.write(html);f.contentDocument.close();
  setTimeout(()=>{try{f.contentWindow.focus();f.contentWindow.print()}catch(e){}setTimeout(()=>f.remove(),2000)},300);
}

/* ручное оформление заказа */
function newOrder(){
  mo={items:[]};
  openModal(`<h2>${t("a_neworder")}</h2><div class="field">
   <div class="two"><div><label>${t("s_name")}</label><input id="m_name"></div><div><label>${t("s_phone")}</label><input id="m_phone" type="tel" inputmode="tel" placeholder="+998"></div></div>
   <div class="two"><div><label>${t("s_delivery")}</label><select id="m_dl" onchange="renderMo()"><option value="delivery">${t("dl_delivery")}</option><option value="pickup">${t("dl_pickup")}</option></select></div>
   <div><label>${t("s_payment")}</label><select id="m_pay"><option value="cash">${t("pay_cash")}</option><option value="card">${t("pay_card")}</option></select></div></div>
   <div id="m_addrw"><label>${t("s_addr")}</label><input id="m_addr"></div>
   <label>${t("a_comment")}</label><input id="m_com">
   <label>${t("a_status")||"Status"}</label><select id="m_st">${STATUSES.map(s=>`<option value="${s}" ${s==="processing"?"selected":""}>${t("st_"+s)}</option>`).join("")}</select>
   <label>${t("a_items")}</label>
   <div style="display:flex;gap:8px"><select id="m_prod" style="margin:0"><option value="">${t("a_choose")}</option>${D.products.filter(p=>p.active!==false&&p.stock>0).map(p=>`<option value="${p.id}">${esc(L(p.name))} — ${fmt(p.price)}</option>`).join("")}</select>
   <input id="m_qty" type="number" min="1" value="1" style="width:80px;margin:0"><button class="btn" onclick="moAdd()">${t("a_add")}</button></div></div>
   <div id="m_list" style="margin:10px 0"></div><button class="btn" style="width:100%" onclick="moSave()">${t("save")}</button>`);
  renderMo();
}
function moAdd(){
  const id=+$("#m_prod").value,q=Math.max(1,Math.floor(+$("#m_qty").value||1));if(!id)return;
  const p=D.products.find(x=>x.id===id),cur=mo.items.find(x=>x.id===id),nq=(cur?cur.qty:0)+q;
  if(nq>p.stock)return toast(t("err_stock"));
  if(cur)cur.qty=nq;else mo.items.push({id,qty:q});renderMo();
}
function moFee(sub){const s=D.settings;return $("#m_dl").value==="delivery"&&sub>0&&!(s.freeFrom>0&&sub>=s.freeFrom)?(+s.deliveryFee||0):0}
function renderMo(){
  $("#m_addrw").classList.toggle("hidden",$("#m_dl").value==="pickup");
  let sub=0;
  $("#m_list").innerHTML=mo.items.map((it,i)=>{const p=D.products.find(x=>x.id===it.id);sub+=p.price*it.qty;
    return `<div class="line"><span>${esc(L(p.name))} × ${it.qty}</span><span><b>${fmt(p.price*it.qty)}</b> <button class="btn danger sm" onclick="mo.items.splice(${i},1);renderMo()">×</button></span></div>`}).join("")+
    `<div class="line"><span>${t("s_fee")}</span><span>${fmt(moFee(sub))}</span></div><div class="line" style="font-weight:800;font-size:17px;border:0"><span>${t("a_total")}</span><span>${fmt(sub+moFee(sub))}</span></div>`;
}
async function moSave(){
  if(!mo.items.length)return toast(t("a_choose"));
  const r=await act(()=>DB.manualOrder({customer:{name:$("#m_name").value,phone:$("#m_phone").value,addr:$("#m_addr").value,comment:$("#m_com").value},items:mo.items,delivery:$("#m_dl").value,payment:$("#m_pay").value},$("#m_st").value));
  if(r){closeModal();toast(t("saved"));await refresh(true)}
}

/* ---------- товары ---------- */
function viewProducts(){
  $("#view").innerHTML=`<div class="box"><div class="toolbar"><input class="inp" placeholder="${t("s_search")}" value="${esc(pq)}" oninput="pq=this.value;renderProdList()"><button class="btn" onclick="editProduct(0)">${t("a_addproduct")}</button></div>
   <div id="plist"></div><p class="note" style="margin-top:10px">${t("a_pricehint")}</p></div>`;
  renderProdList();
}
function renderProdList(){
  const q=pq.trim().toLowerCase();
  const list=D.products.filter(p=>!q||(p.name.ru+" "+p.name.uz).toLowerCase().includes(q));
  $("#plist").innerHTML=list.map(p=>`<div class="prod"><div class="th">${thumb(p)}</div>
   <div class="info"><b>${esc(L(p.name))}</b><br><span class="note">${esc(L(p.cat))}</span></div>
   <div><label>${t("a_price")}</label><input class="pi" type="number" min="0" value="${p.price}" onchange="quick(${p.id},'price',this.value)"></div>
   <div><label>${t("a_stock")}</label><input class="pi s" type="number" min="0" value="${p.stock}" onchange="quick(${p.id},'stock',this.value)" ${p.stock<=5?'style="border-color:var(--red)"':""}></div>
   <label class="sw"><input type="checkbox" ${p.active!==false?"checked":""} onchange="quickActive(${p.id},this.checked)">${t("a_visible")}</label>
   <div style="display:flex;gap:6px"><button class="btn sec sm" onclick="editProduct(${p.id})">${t("edit")}</button><button class="btn danger sm" onclick="delProduct(${p.id})">${t("del")}</button></div></div>`).join("")||`<div class="empty">—</div>`;
}
async function quick(id,f,v){
  const p=D.products.find(x=>x.id===id),val=Math.max(0,Math.round(+v||0));
  const r=await act(()=>DB.saveProduct({...p,[f]:val}));if(r){p[f]=val;toast(t("saved"));renderProdList()}
}
async function quickActive(id,on){const p=D.products.find(x=>x.id===id);const r=await act(()=>DB.saveProduct({...p,active:on}));if(r){p.active=on;toast(t("saved"))}}
async function delProduct(id){if(!confirm(t("confirm_del")))return;const r=await act(()=>DB.deleteProduct(id));if(r){await refresh(true)}}
function editProduct(id){
  const p=id?D.products.find(x=>x.id===id):{name:{ru:"",uz:""},desc:{ru:"",uz:""},cat:{ru:"",uz:""},price:"",old:"",stock:10,emoji:"🛍️",img:"",active:true};
  tmpImg=p.img||"";
  const cats=new Map();D.products.forEach(x=>{if(x.cat&&x.cat.ru)cats.set(x.cat.ru,x.cat.uz)});
  openModal(`<h2>${id?t("a_editproduct"):t("a_newproduct")}</h2><div class="field">
   <label>${t("a_photo")}</label><div class="photo-prev" id="pprev">${tmpImg?`<img src="${esc(tmpImg)}">`:esc(p.emoji||"🛍️")}</div>
   <div style="display:flex;gap:8px;margin-bottom:12px"><label class="btn sec sm" style="cursor:pointer;margin:0;color:var(--blue);font-size:13px">${t("a_upload")}<input type="file" accept="image/*" hidden onchange="pickPhoto(this)"></label><button class="btn danger sm" onclick="tmpImg='';$('#pprev').textContent=$('#f_emoji').value||'🛍️'">${t("a_remove")}</button></div>
   <div class="two"><div><label>${t("a_name_ru")}</label><input id="f_nru" value="${esc(p.name.ru)}"></div><div><label>${t("a_name_uz")}</label><input id="f_nuz" value="${esc(p.name.uz)}"></div></div>
   <div class="two"><div><label>${t("a_cat_ru")}</label><input id="f_cru" list="cl" value="${esc(p.cat.ru)}" oninput="catAuto(this.value)"></div><div><label>${t("a_cat_uz")}</label><input id="f_cuz" value="${esc(p.cat.uz)}"></div></div>
   <datalist id="cl">${[...cats.keys()].map(c=>`<option value="${esc(c)}">`).join("")}</datalist>
   <div class="two"><div><label>${t("a_price")}</label><input id="f_price" type="number" min="0" value="${p.price}"></div><div><label>${t("a_old")}</label><input id="f_old" type="number" min="0" value="${p.old||""}"></div></div>
   <div class="two"><div><label>${t("a_stock")}</label><input id="f_stock" type="number" min="0" value="${p.stock}"></div><div><label>${t("a_emoji")}</label><input id="f_emoji" value="${esc(p.emoji||"🛍️")}"></div></div>
   <label>${t("a_desc_ru")}</label><textarea id="f_dru" rows="3">${esc(p.desc.ru)}</textarea>
   <label>${t("a_desc_uz")}</label><textarea id="f_duz" rows="3">${esc(p.desc.uz)}</textarea>
   <label style="display:flex;gap:8px;align-items:center;color:var(--text);font-size:15px"><input type="checkbox" id="f_active" style="width:20px;height:20px;margin:0" ${p.active!==false?"checked":""}>${t("a_active")}</label></div>
   <button class="btn" style="width:100%;margin-top:12px" onclick="saveProductForm(${id})">${t("save")}</button>`);
  window._cats=cats;
}
function catAuto(v){const u=window._cats&&window._cats.get(v);if(u&&!$("#f_cuz").value)$("#f_cuz").value=u}
function pickPhoto(inp){
  const f=inp.files[0];if(!f)return;const rd=new FileReader();
  rd.onload=()=>{const im=new Image();
    im.onload=()=>{const m=640,k=Math.min(1,m/Math.max(im.width,im.height)),c=document.createElement("canvas");c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);
      const x=c.getContext("2d");x.fillStyle="#fff";x.fillRect(0,0,c.width,c.height);x.drawImage(im,0,0,c.width,c.height);
      tmpImg=c.toDataURL("image/jpeg",.82);$("#pprev").innerHTML=`<img src="${tmpImg}">`};
    im.onerror=()=>toast(t("err_generic"));im.src=rd.result};
  rd.readAsDataURL(f);
}
async function saveProductForm(id){
  const g=s=>$(s).value.trim(),name={ru:g("#f_nru"),uz:g("#f_nuz")},price=$("#f_price").value;
  if(!name.ru||price==="")return toast(t("a_need_name_price"));
  const p={id,name,cat:{ru:g("#f_cru"),uz:g("#f_cuz")},desc:{ru:g("#f_dru"),uz:g("#f_duz")},price:+price,old:+$("#f_old").value||0,stock:Math.max(0,Math.round(+$("#f_stock").value||0)),emoji:g("#f_emoji")||"🛍️",img:tmpImg,active:$("#f_active").checked};
  const r=await act(()=>DB.saveProduct(p));if(r){closeModal();toast(t("saved"));await refresh(true)}
}

/* ---------- клиенты ---------- */
function viewCust(){
  const m=new Map();
  D.orders.filter(o=>o.status!=="cancelled").forEach(o=>{const k=o.customer.phone.replace(/\D/g,"");const c=m.get(k)||{name:o.customer.name,phone:o.customer.phone,n:0,total:0,last:o.date};c.n++;c.total+=o.total;if(o.date>c.last)c.last=o.date;m.set(k,c)});
  const list=[...m.values()].sort((a,b)=>b.total-a.total);
  $("#view").innerHTML=`<div class="box"><div class="tw">${list.length?`<table><tr><th>${t("a_client")}</th><th>${t("s_phone")}</th><th>${t("a_cust_orders")}</th><th>${t("a_cust_total")}</th><th>${t("a_last")}</th></tr>
   ${list.map(c=>`<tr><td><b>${esc(c.name)}</b></td><td><a class="tel" href="tel:${esc(c.phone)}">${esc(c.phone)}</a></td><td>${c.n}</td><td><b>${fmt(c.total)}</b></td><td>${fdate(c.last)}</td></tr>`).join("")}</table>`:`<div class="empty">${t("a_nocust")}</div>`}</div></div>`;
}

