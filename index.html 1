function demoOrders(products){
  let s=7;const r=()=>{s=(s*9301+49297)%233280;return s/233280};
  const names=["Азиз","Дилноза","Жасур","Малика","Рустам","Нигора","Бекзод","Сардор"],out=[];
  for(let i=0;i<34;i++){
    const day=Math.floor(r()*14),time=Date.now()-day*864e5-Math.floor(r()*6e6),items=[],n=1+Math.floor(r()*4);
    for(let k=0;k<n;k++){const p=products[Math.floor(r()*products.length)];if(!items.find(x=>x.id===p.id))items.push({id:p.id,name:p.name,price:p.price,qty:1+Math.floor(r()*3)})}
    const sub=items.reduce((a,x)=>a+x.price*x.qty,0),del=r()<.7,fee=del&&sub<150000?10000:0;
    out.push({date:new Date(time).toISOString(),customer:{name:names[Math.floor(r()*names.length)],phone:"+998 90 "+(100+Math.floor(r()*899))+" "+(10+Math.floor(r()*89))+" "+(10+Math.floor(r()*89)),addr:del?"Toshkent, Navoiy ko'chasi, "+(1+Math.floor(r()*80)):"",comment:""},items,sub,fee,total:sub+fee,delivery:del?"delivery":"pickup",payment:r()<.6?"cash":"card",status:day>=2?(r()<.08?"cancelled":"delivered"):(r()<.5?"new":"processing")});
  }
  out.sort((a,b)=>a.date<b.date?-1:1).forEach((o,i)=>o.id=1001+i);
  return out;
}
